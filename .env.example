# ---------------------------------------------------------------------------
# AI Market Intelligence Platform - environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=local                 # local | test | staging | production
DEBUG=true
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_RENDERER=console              # console for local dev, json when deployed

# --- PostgreSQL (Supabase in production) -----------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=market_intel
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_ECHO_SQL=false

# --- MongoDB (Atlas in production) -----------------------------------------
MONGO_URI=mongodb://mongo:mongo@localhost:27017/?authSource=admin
MONGO_DATABASE=market_intel
MONGO_VECTOR_INDEX_NAME=rag_documents_vector_index

# --- Security --------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECURITY_SECRET_KEY=change-me-before-deploying
# Argon2id password hashing needs no configuration; JWT signing does.
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_TTL_MINUTES=30
SECURITY_REFRESH_TOKEN_TTL_DAYS=14

# --- Data ingestion --------------------------------------------------------
# Optional. Without it the platform ingests news from RSS and SEC only, which
# need no credential; NewsAPI is skipped with a log line rather than failing.
INGEST_NEWSAPI_KEY=
# SEC requires a descriptive User-Agent with real contact details. Requests
# without one are refused outright — put your own name and email here.
INGEST_SEC_USER_AGENT=AI Market Intelligence Platform (your.email@example.com)
INGEST_INITIAL_BACKFILL_DAYS=730
INGEST_INCREMENTAL_OVERLAP_DAYS=5
INGEST_MAX_CONCURRENT_FETCHES=4
INGEST_MAX_RETRIES=3
# Per-ticker financial news from Yahoo Finance. No credential required.
INGEST_YAHOO_NEWS_ENABLED=true

# --- Analysis --------------------------------------------------------------
# FinBERT needs the optional `ml` extra (~2GB of torch). Off by default; the
# platform falls back to lexicon sentiment with a log line.
# Answer generation. Without a key the platform answers extractively --
# quoting retrieved sources instead of synthesising -- which reads worse but
# cannot fabricate.
LLM_OPENAI_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
# Embeddings. Without a key retrieval matches wording, not meaning.
EMBED_OPENAI_API_KEY=

# --- Local models (Ollama) ---------------------------------------------------
# Preferred over OpenAI for both generation and embedding when reachable: no
# key, no per-token cost, and no article or question leaves the machine.
# Selection is automatic -- the platform probes for a running server at startup
# and falls back to OpenAI, then to the offline fallbacks, without failing.
#
#   brew install ollama && ollama serve
#   ollama pull llama3.2:3b        # ~2GB, generation
#   ollama pull nomic-embed-text   # ~0.3GB, embeddings
#
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# 768 is nomic's native width, not OpenAI's 1536. Changing the model means
# re-embedding the corpus and rebuilding the vector index: a collection holding
# two widths returns nonsense rather than an error.
OLLAMA_EMBEDDING_DIMENSIONS=768
# Generous because inference runs here, not on a vendor's servers. A cold model
# load alone can take half a minute; the 20s ingestion default made a running
# server report itself as unreachable partway through embedding a corpus.
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
# Cosine below which retrieval is treated as "no relevant information" and the
# question is refused. Measured against 400 stored articles: off-topic
# questions topped out at 0.526, on-topic ones bottomed out at 0.616. Re-derive
# after changing the embedding model with:
#   python -m app.services.rag.measure_floor
OLLAMA_RELEVANCE_FLOOR=0.571

ANALYSIS_USE_FINBERT=false
ANALYSIS_Z_SCORE_THRESHOLD=3.0
ANALYSIS_ISOLATION_FOREST_CONTAMINATION=0.02

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
# 22:30 UTC on weekdays: after the US close, before Asia opens.
SCHEDULER_PRICE_INGESTION_CRON=30 22 * * mon-fri
SCHEDULER_NEWS_INGESTION_CRON=5 * * * *

# --- docker-compose only ---------------------------------------------------
MONGO_ROOT_USER=mongo
MONGO_ROOT_PASSWORD=mongo
API_PORT=8000
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------
# Added in later milestones (kept here so the template stays the single
# reference for what the platform consumes):
#
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ---------------------------------------------------------------------------

# --- Market data ------------------------------------------------------------
# Finnhub free tier (finnhub.io/register, no card). Verified to serve: NASDAQ
# universe, profile + official logo, quote, 133 metrics, financial statements,
# analyst ratings, insider transactions, earnings, news.
# Verified NOT to serve on free: candles (403), price targets (403),
# dividends (403) -- the adapter declares those capabilities as unsupported.
MARKETDATA_FINNHUB_API_KEY=

# Twelve Data free tier (twelvedata.com, no card), 800 calls/day. Needed for
# historical OHLC, which Finnhub's free tier refuses -- so charts depend on it.
MARKETDATA_TWELVEDATA_API_KEY=
