# ---------------------------------------------------------------------------
# AI Market Intelligence Platform - environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=local                 # local | test | staging | production
DEBUG=true
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_RENDERER=console              # console for local dev, json when deployed

# --- PostgreSQL (Supabase in production) -----------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=market_intel
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_ECHO_SQL=false

# --- MongoDB (Atlas in production) -----------------------------------------
MONGO_URI=mongodb://mongo:mongo@localhost:27017/?authSource=admin
MONGO_DATABASE=market_intel
MONGO_VECTOR_INDEX_NAME=rag_documents_vector_index

# --- Security --------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECURITY_SECRET_KEY=change-me-before-deploying
SECURITY_ACCESS_TOKEN_TTL_MINUTES=30
SECURITY_REFRESH_TOKEN_TTL_DAYS=14

# --- Data ingestion --------------------------------------------------------
# Optional. Without it the platform ingests news from RSS and SEC only, which
# need no credential; NewsAPI is skipped with a log line rather than failing.
INGEST_NEWSAPI_KEY=
# SEC requires a descriptive User-Agent with real contact details. Requests
# without one are refused outright — put your own name and email here.
INGEST_SEC_USER_AGENT=AI Market Intelligence Platform (your.email@example.com)
INGEST_INITIAL_BACKFILL_DAYS=730
INGEST_INCREMENTAL_OVERLAP_DAYS=5
INGEST_MAX_CONCURRENT_FETCHES=4
INGEST_MAX_RETRIES=3

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
# 22:30 UTC on weekdays: after the US close, before Asia opens.
SCHEDULER_PRICE_INGESTION_CRON=30 22 * * mon-fri
SCHEDULER_NEWS_INGESTION_CRON=5 * * * *

# --- docker-compose only ---------------------------------------------------
MONGO_ROOT_USER=mongo
MONGO_ROOT_PASSWORD=mongo
API_PORT=8000

# ---------------------------------------------------------------------------
# Added in later milestones (kept here so the template stays the single
# reference for what the platform consumes):
#
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ---------------------------------------------------------------------------
